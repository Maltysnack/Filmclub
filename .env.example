# Supabase project URL and public key. Safe in the browser, because database rules protect the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
TMDB_API_KEY=
OMDB_API_KEY=
# Any long random string. Vercel sends it to the cleanup job.
CRON_SECRET=
# Optional. Defaults to https://filmclub.watch
NEXT_PUBLIC_SITE_URL=
# Optional. Shows a GitHub link on the home screen. Only set this once the repo is public.
NEXT_PUBLIC_GITHUB_URL=
