# ── Supabase ─────────────────────────────────────────────────────────────────
# Project URL (public — safe in client bundle)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Anon/public key (safe in client bundle, gated by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Service role key (SERVER ONLY — never prefix with NEXT_PUBLIC_).
# Used by cron routes and the feedback handler to bypass RLS for server-side
# inserts/deletes. Reveal this in Supabase → Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── TMDB ─────────────────────────────────────────────────────────────────────
# Public — used client-side for film search and detail.
# Get from https://www.themoviedb.org → Settings → API → API Key (v3 auth).
NEXT_PUBLIC_TMDB_API_KEY=

# ── OMDb ─────────────────────────────────────────────────────────────────────
# Server-side only — used by /api/omdb proxy and the daily backfill cron.
# Free tier covers 1000 req/day. Get at https://www.omdbapi.com/apikey.aspx.
OMDB_API_KEY=

# ── GitHub ───────────────────────────────────────────────────────────────────
# Personal access token used by /api/feedback to create issues for bug
# reports / feature requests. Needs `repo` scope on the Filmclub repo.
GITHUB_TOKEN=github_pat_...

# ── Resend ───────────────────────────────────────────────────────────────────
# Transactional email — feedback notifications + daily digest. Get at
# https://resend.com → API Keys.
RESEND_API_KEY=re_...

# ── Cron auth ────────────────────────────────────────────────────────────────
# Vercel cron sends this as `Authorization: Bearer <secret>`. Set it to any
# strong random string (e.g. `openssl rand -hex 32`).
CRON_SECRET=
